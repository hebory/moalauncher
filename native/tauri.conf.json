{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moa Launcher",
  "version": "0.3.0",
  "identifier": "com.moa.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Moa Launcher",
        "width": 1000,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false,
        "backgroundColor": "#f5f6fa"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico", "icons/icon.png"] }
}
