<Window x:Class="MoaLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Moa Launcher" Width="1320" Height="880" MinWidth="1080" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/></Style>
    <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Width" Value="44"/><Setter Property="Height" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="Foreground" Value="#667085"/></Style>
    <Style x:Key="Metric" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="20,16"/></Style>
  </Window.Resources>
  <Border BorderBrush="#E0E4ED" BorderThickness="1">
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#171D2B">
        <Grid Margin="18,0">
          <Grid.RowDefinitions><RowDefinition Height="116"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,2,0,0">
              <Border Width="38" Height="38" CornerRadius="12" Background="#6A7EF5" Margin="0,0,12,0"><Viewbox Width="22" Height="18"><Path Stroke="White" StrokeThickness="3.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M2,16 L2,6 C2,0 10,0 10,6 L10,16 M10,6 C10,0 18,0 18,6 L18,16"/></Viewbox></Border>
              <StackPanel><TextBlock Text="moa" Foreground="White" FontFamily="Segoe UI" FontSize="28" FontWeight="Bold" Margin="0,-8,0,0"/><TextBlock Text="L A U N C H E R" Foreground="#7F8BA7" FontFamily="Segoe UI" FontSize="9" Margin="1,0,0,0"/></StackPanel>
            </StackPanel>
          </Grid>
          <StackPanel Grid.Row="1">
            <TextBlock Text="워크스페이스" Foreground="#7B88A3" FontSize="11" Margin="14,4,0,15"/>
            <Button x:Name="LibraryNav" Style="{StaticResource NavButton}" Click="Library_Click" Background="#2A344E" Foreground="White" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="0,0,13,0"/><TextBlock Text="라이브러리"/></StackPanel></Button>
            <Button x:Name="UpdatesNav" Style="{StaticResource NavButton}" Click="Updates_Click" Margin="0,0,0,6"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="0,0,13,0"/><TextBlock Text="업데이트"/></StackPanel></Button>
            <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Click="Settings_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" VerticalAlignment="Center" Margin="0,0,13,0"/><TextBlock Text="설정"/></StackPanel></Button>
          </StackPanel>
          <StackPanel Grid.Row="3" Margin="8,0,8,24">
            <Border Background="#20283B" BorderBrush="#303B54" BorderThickness="1" CornerRadius="13" Padding="16" Margin="0,0,0,24">
              <StackPanel>
                <Border Width="30" Height="30" CornerRadius="9" Background="#303C5B" HorizontalAlignment="Left" Margin="0,0,0,12"><TextBlock Text="+" Foreground="#ABBAFF" FontSize="23" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,-3,0,0"/></Border>
                <TextBlock Text="도구가 늘어나도,&#10;모아 한곳에서." FontSize="14" FontWeight="Bold" Foreground="#E2E8F6" LineHeight="23"/>
                <TextBlock Text="내게 필요한 도구를&#10;간편하게 추가하세요." FontSize="11" Foreground="#A2AEC7" LineHeight="19" Margin="0,9,0,14"/>
                <Button Content="프로그램 추가  +" Click="AddApp_Click" Background="#303C58" Foreground="#D9E2FF" BorderThickness="0" Padding="10,9" FontSize="11"/>
              </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="#7D91F7" Margin="0,0,8,0"/><TextBlock Text="Moa Launcher" Foreground="#9AA7C1" FontSize="11"/><TextBlock Text="0.1.0" Foreground="#8592AC" FontFamily="Segoe UI" FontSize="11" Margin="9,0,0,0"/></StackPanel>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="*"/><RowDefinition Height="39"/></Grid.RowDefinitions>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0"><TextBlock Text="내 워크스페이스" Foreground="#8C95A6" FontSize="11"/><TextBlock Text="/" Foreground="#CBD0DA" Margin="12,0"/><TextBlock x:Name="BreadcrumbText" Text="라이브러리" FontSize="11" Foreground="#4A556C" FontWeight="SemiBold"/></StackPanel>
            <Grid Grid.Column="1" VerticalAlignment="Center">
              <TextBox x:Name="SearchBox" Height="36" MinHeight="36" Background="#F6F7FB" Padding="30,0,8,0" TextChanged="Search_Changed" AutomationProperties.Name="프로그램 검색" ToolTip="이름, 설명 또는 저장소로 검색"/>
              <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14" Stroke="#9AA4B6" StrokeThickness="1.5" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
              <TextBlock Text="프로그램 검색" Margin="35,0,0,0" VerticalAlignment="Center" Foreground="#98A1B3" FontSize="11" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="18,0,8,0" VerticalAlignment="Top">
              <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" AutomationProperties.Name="최소화" ToolTip="최소화"><Path Data="M0,5 H11" Width="11" Stroke="#667085" StrokeThickness="1"/></Button>
              <Button Style="{StaticResource CaptionButton}" Click="Maximize_Click" AutomationProperties.Name="최대화 또는 복원" ToolTip="최대화 / 복원"><Rectangle Width="10" Height="10" Stroke="#667085" StrokeThickness="1"/></Button>
              <Button Style="{StaticResource CaptionButton}" Click="Close_Click" AutomationProperties.Name="닫기" ToolTip="닫기"><Path Data="M0,0 L10,10 M10,0 L0,10" Width="10" Height="10" Stroke="#667085" StrokeThickness="1.2"/></Button>
            </StackPanel>
          </Grid>
        </Border>
        <ScrollViewer x:Name="LibraryView" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="30,30,30,20" MaxWidth="1180">
            <Grid Margin="0,0,0,26"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="모아두면, 시작이 가벼워집니다." Foreground="#8A93A5" FontSize="11" Margin="0,0,0,8"/><TextBlock x:Name="PageTitle" Text="라이브러리" FontSize="29" FontWeight="Bold"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="15,0,0,4"><Button x:Name="RefreshButton" Content="↻  업데이트 확인" Click="Refresh_Click" FontSize="12" Margin="0,0,9,0"/><Button Content="+  프로그램 추가" Click="AddApp_Click" Style="{StaticResource PrimaryButton}" FontSize="12"/></StackPanel>
            </Grid>
            <Grid Margin="0,0,0,28">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource Metric}"><DockPanel><Border DockPanel.Dock="Right" Width="36" Height="36" Background="#F0F2F9" CornerRadius="11" VerticalAlignment="Center"><TextBlock Text="&#xE8A9;" FontFamily="Segoe MDL2 Assets" Foreground="#7B87A2" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel><TextBlock Text="내 프로그램" FontSize="11" Foreground="#8B94A5"/><TextBlock x:Name="TotalCount" Text="0" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource Metric}"><DockPanel><Border DockPanel.Dock="Right" Width="36" Height="36" Background="#EAF6F0" CornerRadius="11" VerticalAlignment="Center"><Path Width="14" Height="11" Stroke="#4B9C7A" StrokeThickness="1.7" Stretch="Uniform" Data="M0,5 L5,10 L14,0"/></Border><StackPanel><TextBlock Text="설치된 프로그램" FontSize="11" Foreground="#8B94A5"/><TextBlock x:Name="InstalledCount" Text="0" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
              <Border Grid.Column="4" Style="{StaticResource Metric}" Background="#EEF1FF" BorderBrush="#DCE2FF"><DockPanel><Border DockPanel.Dock="Right" Width="36" Height="36" Background="#DFE5FF" CornerRadius="11" VerticalAlignment="Center"><Path Width="15" Height="15" Stroke="#6074DE" StrokeThickness="1.6" Stretch="Uniform" Data="M8,0 V11 M3,6 L8,11 L13,6 M1,13 V16 H15 V13"/></Border><StackPanel><TextBlock Text="업데이트 가능" FontSize="11" Foreground="#7D88B3"/><TextBlock x:Name="UpdateCount" Text="0" Foreground="#5369E8" FontSize="28" FontWeight="SemiBold" FontFamily="Segoe UI" Margin="0,3,0,0"/></StackPanel></DockPanel></Border>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
              <StackPanel>
                <DockPanel Margin="0,0,0,15"><Border DockPanel.Dock="Right" Background="#E9ECF3" CornerRadius="9" Padding="3"><StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="전체" Click="All_Click" Style="{StaticResource GhostButton}" FontSize="11" Padding="13,7" Margin="0,0,3,0"/><Button x:Name="InstalledFilter" Content="설치됨" Click="Installed_Click" Style="{StaticResource GhostButton}" FontSize="11" Padding="13,7"/></StackPanel></Border><TextBlock Text="프로그램" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/></DockPanel>
                <Border x:Name="EmptyPanel" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="25,35" Visibility="Collapsed" Margin="0,0,0,14"><StackPanel><Border Background="#F0F3FB" Width="48" Height="48" CornerRadius="15" HorizontalAlignment="Center" Margin="0,0,0,17"><Path Stroke="#98A5C2" StrokeThickness="1.8" Width="21" Height="21" Stretch="Uniform" Data="M9,1 A8,8 0 1 0 9,17 A8,8 0 1 0 9,1 M15,15 L22,22"/></Border><TextBlock x:Name="EmptyText" Text="표시할 프로그램이 없습니다." TextAlignment="Center" Foreground="#69758C" FontSize="12" LineHeight="22"/><Button Content="전체 프로그램 보기" Click="ClearFilters_Click" Style="{StaticResource GhostButton}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,15,0,0"/></StackPanel></Border>
                <ItemsControl x:Name="AppCards"><ItemsControl.ItemTemplate><DataTemplate>
                  <Border CornerRadius="16" Padding="22" Margin="0,0,0,14">
                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E8EF"/><Setter Property="BorderThickness" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="#A5B2F5"/></DataTrigger></Style.Triggers></Style></Border.Style>
                    <StackPanel>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="54" Height="54" CornerRadius="16" Background="{Binding AccentColor}" Margin="0,0,15,0"><TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="19" FontWeight="Bold"/><TextBlock Text="{Binding Category}" Foreground="#8D97A9" FontSize="10" Margin="0,5,0,0"/></StackPanel>
                        <Button Grid.Column="2" Content="···" Click="Details_Click" Style="{StaticResource GhostButton}" Padding="10,4" FontSize="19" ToolTip="프로그램 상세 정보" AutomationProperties.Name="프로그램 상세 정보" VerticalAlignment="Top"/>
                      </Grid>
                      <TextBlock Text="{Binding Description}" Foreground="#6F7B91" FontSize="12" LineHeight="22" Margin="0,17,0,17"/>
                      <Border Background="#F6F8FC" CornerRadius="8" Padding="10,9" Margin="0,0,0,16"><DockPanel><Ellipse Width="5" Height="5" Fill="{Binding StatusColor}" Margin="0,0,7,0"/><TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="10"/></DockPanel></Border>
                      <ProgressBar Value="{Binding Percent}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,12"/>
                      <Border Background="#FFF8EA" CornerRadius="8" Padding="11,9" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,14"><TextBlock Text="{Binding Error}" Foreground="#9B773A" FontSize="11" LineHeight="19"/></Border>
                      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding VersionText}" Foreground="#8994A9" FontSize="10" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="AppAction_Click" Style="{StaticResource PrimaryButton}" MinWidth="108" Padding="16,10" FontSize="12"/></Grid>
                      <Button Content="다운로드 취소" Click="Cancel_Click" Style="{StaticResource GhostButton}" FontSize="11" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" Margin="0,9,0,0"/>
                    </StackPanel>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Button Click="AddApp_Click" Background="Transparent" BorderBrush="#DDE2EE" Padding="18" HorizontalContentAlignment="Stretch" Margin="0,2,0,0"><DockPanel><Border Width="35" Height="35" CornerRadius="10" Background="#E9EDF8" Margin="0,0,13,0"><TextBlock Text="+" FontSize="24" Foreground="#8694BD" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,-4,0,0"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="새로운 프로그램 추가" FontWeight="SemiBold" FontSize="12" Foreground="#5B6882"/><TextBlock Text="즐겨 쓰는 도구를 모아에 연결하세요." Foreground="#8995AD" FontSize="10" Margin="0,5,0,0"/></StackPanel></DockPanel></Button>
                <TextBlock Text="업데이트를 확인하고, 원하는 앱만 설치하세요." Foreground="#929DB1" FontSize="10" TextAlignment="Center" Margin="0,20,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="프로그램 정보" Style="{StaticResource SectionTitle}" Margin="0,9,0,21"/>
                <Border x:Name="DetailsPlaceholder" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="25,42"><StackPanel><TextBlock Text="도구를 조금 더 자세히" FontSize="15" FontWeight="Bold" TextAlignment="Center"/><TextBlock Text="프로그램의 ··· 버튼을 누르면&#10;버전과 변경 사항을 볼 수 있어요." Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="22" TextAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border>
                <Border x:Name="DetailsPanel" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Visibility="Collapsed" Padding="20">
                  <StackPanel>
                    <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="앱 상세" Foreground="#8A93A5" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Grid.Column="1" Content="×" Click="CloseDetails_Click" Style="{StaticResource GhostButton}" Padding="6,0" FontSize="19" ToolTip="상세 정보 닫기"/></Grid>
                    <Border CornerRadius="12" Background="#F0F3FF" Padding="12" Margin="0,0,0,14"><DockPanel><Border Width="44" Height="44" CornerRadius="13" Background="{Binding AccentColor}" Margin="0,0,13,0"><TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="19" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/><TextBlock Text="{Binding Category}" Foreground="#8A93AD" FontSize="10" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
                    <Border BorderBrush="#EEF0F5" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,16"><StackPanel><DockPanel Margin="0,0,0,9"><TextBlock Text="설치 버전" Foreground="#8A96AC" FontSize="10"/><TextBlock Text="{Binding InstalledVersion}" Foreground="#5E6980" FontSize="11" TextAlignment="Right" FontFamily="Segoe UI"/></DockPanel><DockPanel><TextBlock Text="최신 버전" Foreground="#8A96AC" FontSize="10"/><TextBlock Text="{Binding LatestVersion}" Foreground="{StaticResource AccentBrush}" FontSize="11" TextAlignment="Right" FontFamily="Segoe UI"/></DockPanel></StackPanel></Border>
                    <TextBlock Text="새로운 소식" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                    <ScrollViewer MaxHeight="64" VerticalScrollBarVisibility="Auto"><TextBlock Text="{Binding Notes}" Foreground="#758197" FontSize="11" LineHeight="20"/></ScrollViewer>
                    <TextBlock Text="{Binding SourceText}" Foreground="#99A3B6" FontSize="9" Margin="0,10,0,13"/>
                    <Button Content="GitHub 릴리스 보기  ↗" Click="OpenRepository_Click" FontSize="11" Margin="0,0,0,9" IsEnabled="{Binding HasRepository}"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="설치 폴더" Click="OpenInstallFolder_Click" IsEnabled="{Binding IsInstalled}" FontSize="10" Padding="8,9"/><Button Grid.Column="2" Content="프로그램 설정" Click="EditApp_Click" FontSize="10" Padding="8,9"/></Grid>
                    <Button Content="앱 실행 ↗" Click="Launch_Click" IsEnabled="{Binding IsInstalled}" Style="{StaticResource GhostButton}" FontSize="11" Margin="0,7,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="34,34" MaxWidth="820">
            <TextBlock Text="모아를 나답게 사용하는 방법" Foreground="#8A93A5" FontSize="11" Margin="0,0,0,8"/><TextBlock Text="설정" FontSize="29" FontWeight="Bold" Margin="0,0,0,30"/>
            <TextBlock Text="업데이트" Style="{StaticResource SectionTitle}" Margin="0,0,0,14"/>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24"><StackPanel>
              <CheckBox x:Name="StartupCheck" Content="런처를 열 때 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
              <TextBlock Text="프로그램의 최신 상태로 하루를 시작하세요." Foreground="#8C98AD" FontSize="11" Margin="0,8,0,20"/>
              <Border Height="1" Background="#EDF0F5" Margin="0,0,0,20"/>
              <CheckBox x:Name="PeriodicCheck" Content="실행 중 30분마다 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
              <TextBlock Text="설치와 업데이트는 직접 버튼을 눌렀을 때 시작됩니다." Foreground="#8C98AD" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="프로그램과 데이터" Style="{StaticResource SectionTitle}" Margin="0,28,0,14"/>
            <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="24"><StackPanel>
              <TextBlock Text="저장 위치" FontSize="12" FontWeight="SemiBold"/><Border Background="#F7F8FB" CornerRadius="8" Padding="12" Margin="0,10,0,15"><TextBlock x:Name="DataPathText" Foreground="#8B95A8" FontSize="11"/></Border>
              <WrapPanel><Button Content="데이터 폴더 열기 ↗" Click="OpenDataFolder_Click" FontSize="11" Margin="0,0,8,8"/><Button Content="카탈로그 가져오기" Click="ImportCatalog_Click" FontSize="11" Margin="0,0,8,8"/><Button Content="카탈로그 내보내기" Click="ExportCatalog_Click" FontSize="11" Margin="0,0,0,8"/></WrapPanel>
              <TextBlock Text="카탈로그로 여러 프로그램의 설정을 한 번에 옮길 수 있습니다. 신뢰하는 배포자의 JSON 파일을 사용하세요." Foreground="#8C98AD" FontSize="11" LineHeight="21" Margin="0,10,0,0"/>
            </StackPanel></Border>
            <TextBlock Text="Moa Launcher 0.1.0  ·  Windows&#10;공식 릴리스에서 내려받은 파일의 무결성을 확인합니다." Foreground="#99A3B6" FontSize="10" LineHeight="21" Margin="0,25,0,0"/>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#FAFBFD" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0"><Grid VerticalAlignment="Center"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="모아에 오신 것을 환영합니다." Foreground="#8A95AA" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,15,0"/><TextBlock Grid.Column="1" x:Name="LastCheckedText" Text="아직 확인하지 않음" Foreground="#8F9CB2" FontSize="10"/></Grid></Border>
      </Grid>
    </Grid>
  </Border>
</Window>
