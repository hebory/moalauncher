<Window x:Class="MoaLauncher.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MoaLauncher.App"
        Title="Moa Launcher" Width="960" Height="700" MinWidth="760" MinHeight="560"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}" UseLayoutRounding="True">
  <Window.Resources>
    <local:GridCardWidthConverter x:Key="GridCardWidth"/>
    <ItemsPanelTemplate x:Key="ListAppPanel"><StackPanel/></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="GridAppPanel">
      <WrapPanel ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource GridCardWidth}}"/>
    </ItemsPanelTemplate>
    <Style x:Key="ViewModeButton" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Surface" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{StaticResource SoftAccentBrush}"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SoftAccentBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ListAppTemplate">
      <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Padding="20" Margin="0,0,0,12">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid Width="48" Height="48" Margin="0,0,16,0" VerticalAlignment="Center">
              <Border CornerRadius="13" Background="{Binding AccentColor}">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="21" FontWeight="Bold"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Image Source="{Binding IconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                     AutomationProperties.Name="{Binding Name, StringFormat='{}{0} 아이콘'}"/>
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,18,0">
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                <Border Grid.Column="1" Background="{StaticResource SoftAccentBrush}" CornerRadius="5" Padding="7,2" Margin="8,2,0,0" MaxWidth="140"
                        VerticalAlignment="Center" ToolTip="{Binding InstalledVersion, StringFormat='설치 버전 {0}'}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding InstalledVersionLabel}" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                             Foreground="{StaticResource AccentBrush}"
                             AutomationProperties.Name="{Binding InstalledVersion, StringFormat='설치 버전 {0}'}"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                         Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
              <TextBlock Text="비공개 · 개인 카탈로그" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0"
                         Visibility="{Binding IsPrivate, Converter={StaticResource BoolVisibility}}"/>
              <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,8,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
              <Button x:Name="AppActionButton" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="AppAction_Click"
                      Style="{StaticResource PrimaryButton}" MinWidth="108" FontSize="12" Padding="16,9"/>
              <Button Content="상세 보기" Click="Details_Click" Style="{StaticResource GhostButton}"
                      Padding="12,6" FontSize="11" Margin="0,4,0,0" AutomationProperties.Name="프로그램 상세 보기"/>
            </StackPanel>
          </Grid>
          <ProgressBar Value="{Binding Percent}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="64,14,0,0"/>
          <Border Background="#FFF8EA" CornerRadius="8" Padding="11,9" Margin="64,12,0,0"
                  Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
            <TextBlock Text="{Binding Error}" Foreground="#926B28" FontSize="11" LineHeight="18"/>
          </Border>
          <Button Content="다운로드 취소" Click="Cancel_Click" Style="{StaticResource GhostButton}"
                  FontSize="11" HorizontalAlignment="Right" Margin="0,8,0,0"
                  Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
        </StackPanel>
      </Border>
    </DataTemplate>
    <DataTemplate x:Key="GridAppTemplate">
      <Border x:Name="GridAppCard" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
              CornerRadius="12" Margin="6,0,6,12" MinHeight="350">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="110"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border CornerRadius="11,11,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding AccentColor}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasCover}" Value="True">
                    <Setter Property="Background"><Setter.Value><ImageBrush ImageSource="{Binding CoverImage}" Stretch="UniformToFill"/></Setter.Value></Setter>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock Text="{Binding Monogram}" Foreground="White" Opacity="0.3" FontFamily="Segoe UI" FontSize="58" FontWeight="Bold"
                       VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,22,0" TextWrapping="NoWrap">
              <TextBlock.Style><Style TargetType="TextBlock">
                <Style.Triggers><DataTrigger Binding="{Binding HasCover}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style></TextBlock.Style>
            </TextBlock>
          </Border>
          <StackPanel Grid.Row="1" Margin="16,16,16,12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid Width="40" Height="40" VerticalAlignment="Center">
                <Border CornerRadius="11" Background="{Binding AccentColor}">
                  <Border.Style><Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding IconImage}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style></Border.Style>
                  <TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="19" FontWeight="Bold" Foreground="White"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <Image Source="{Binding IconImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                       AutomationProperties.Name="{Binding Name, StringFormat='{}{0} 아이콘'}"/>
              </Grid>
              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                <Border Background="{StaticResource SoftAccentBrush}" CornerRadius="5" Padding="6,2" Margin="0,4,0,0" MaxWidth="140"
                        HorizontalAlignment="Left" ToolTip="{Binding InstalledVersion, StringFormat='설치 버전 {0}'}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolVisibility}}">
                  <TextBlock Text="{Binding InstalledVersionLabel}" FontSize="10" Foreground="{StaticResource AccentBrush}"
                             TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" AutomationProperties.Name="{Binding InstalledVersion, StringFormat='설치 버전 {0}'}"/>
                </Border>
              </StackPanel>
            </Grid>
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="17" LineStackingStrategy="BlockLineHeight"
                       Margin="0,12,0,0" Height="34" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}"/>
            <TextBlock Text="비공개 · 개인 카탈로그" FontSize="10" Foreground="{StaticResource AccentBrush}" Margin="0,6,0,0"
                       Visibility="{Binding IsPrivate, Converter={StaticResource BoolVisibility}}"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor}" FontSize="11" Margin="0,8,0,0"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
            <ProgressBar Value="{Binding Percent}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,10,0,0"/>
            <Border Background="#FFF8EA" CornerRadius="8" Padding="10,8" Margin="0,10,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
              <TextBlock Text="{Binding Error}" Foreground="#926B28" FontSize="11" LineHeight="18"/>
            </Border>
            <Button Content="다운로드 취소" Click="Cancel_Click" Style="{StaticResource GhostButton}" FontSize="11"
                    HorizontalAlignment="Right" Margin="0,6,0,0" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}"/>
          </StackPanel>
          <StackPanel Grid.Row="2" Margin="16,0,16,12">
            <Button x:Name="AppActionButton" Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Click="AppAction_Click"
                    Style="{StaticResource PrimaryButton}" FontSize="12" Padding="10,9"/>
            <Button Content="상세 보기" Click="Details_Click" Style="{StaticResource GhostButton}" Padding="10,6"
                    FontSize="11" Margin="0,4,0,0" AutomationProperties.Name="프로그램 상세 보기"/>
          </StackPanel>
        </Grid>
      </Border>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="36"/>
    </Grid.RowDefinitions>

    <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="28,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource AccentBrush}" Margin="0,0,10,0">
            <Viewbox Width="18" Height="16"><Path Stroke="White" StrokeThickness="3.8"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                Data="M2,16 L2,6 C2,0 10,0 10,6 L10,16 M10,6 C10,0 18,0 18,6 L18,16"/></Viewbox>
          </Border>
          <TextBlock Text="moa" FontFamily="Segoe UI" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
          <TextBlock Text="Launcher" FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource MutedBrush}"
                     VerticalAlignment="Center" Margin="8,4,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="LibraryNav" Content="프로그램" Style="{StaticResource GhostButton}"
                  Background="{StaticResource SoftAccentBrush}" Foreground="{StaticResource AccentBrush}"
                  Click="Library_Click" Margin="0,0,6,0"/>
          <Button x:Name="SettingsNav" Content="설정" Style="{StaticResource GhostButton}" Click="Settings_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid x:Name="LibraryView" Grid.Row="1" Margin="28,26,28,0" MaxWidth="1000">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="PageTitle" Text="내 프로그램" FontSize="23" FontWeight="Bold"/>
          <TextBlock x:Name="LibrarySummary" Text="0개 프로그램" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="UpdateAllButton" Content="모두 업데이트" Click="UpdateAll_Click" IsEnabled="False"
                  Style="{StaticResource PrimaryButton}" FontSize="12" Margin="0,0,8,0"
                  ToolTip="검색과 관계없이 일반 프로그램을 순서대로 업데이트한 뒤 런처를 마지막에 업데이트합니다. 실패하거나 취소하면 남은 작업을 중단합니다."/>
          <Button x:Name="StopUpdatesButton" Content="전체 업데이트 중단" Click="StopUpdates_Click" Visibility="Collapsed"
                  FontSize="12" Margin="0,0,8,0" ToolTip="다운로드는 취소하고, 이미 시작된 설치는 끝난 뒤 남은 업데이트를 중단합니다."/>
          <Button x:Name="RefreshButton" Content="업데이트 확인" Click="Refresh_Click" FontSize="12" Margin="0,0,8,0"/>
          <Button Content="+ 프로그램 추가" Click="AddApp_Click" FontSize="12"/>
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" Margin="0,0,0,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="AllFilter" Content="전체" Click="All_Click" Style="{StaticResource GhostButton}" Padding="12,8" FontSize="12" Margin="0,0,4,0"/>
          <Button x:Name="InstalledFilter" Content="설치됨" Click="Installed_Click" Style="{StaticResource GhostButton}" Padding="12,8" FontSize="12" Margin="0,0,4,0"/>
          <Button x:Name="UpdatesNav" Content="업데이트" Click="Updates_Click" Style="{StaticResource GhostButton}" Padding="12,8" FontSize="12"/>
        </StackPanel>
        <Border Grid.Column="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="3" Margin="8,0,10,0">
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ListViewButton" GroupName="LibraryViewMode" IsChecked="True" Checked="ViewMode_Changed"
                         Style="{StaticResource ViewModeButton}" ToolTip="리스트 보기" AutomationProperties.Name="리스트 보기">
              <Path Data="M1,2 H15 M1,7 H15 M1,12 H15" Width="14" Height="12" StrokeThickness="1.5" Stretch="Fill"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton>
            <RadioButton x:Name="GridViewButton" GroupName="LibraryViewMode" Checked="ViewMode_Changed"
                         Style="{StaticResource ViewModeButton}" ToolTip="그리드 보기" AutomationProperties.Name="그리드 보기">
              <Path Data="M0,0 H5 V5 H0 Z M9,0 H14 V5 H9 Z M0,9 H5 V14 H0 Z M9,9 H14 V14 H9 Z" Width="14" Height="14" StrokeThickness="1.2" Stretch="Uniform"
                    Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
            </RadioButton>
          </StackPanel>
        </Border>
        <Grid Grid.Column="2">
          <TextBox x:Name="SearchBox" Height="36" MinHeight="36" Padding="30,0,10,0"
                   TextChanged="Search_Changed" AutomationProperties.Name="프로그램 검색"/>
          <Path Data="M6,1 A5,5 0 1 0 6,11 A5,5 0 1 0 6,1 M10,10 L14,14" Stroke="#9AA4B6"
                StrokeThickness="1.5" Width="14" Height="14" HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="프로그램 검색" Margin="32,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" FontSize="12" IsHitTestVisible="False">
            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
            </Style></TextBlock.Style>
          </TextBlock>
        </Grid>
      </Grid>

      <ScrollViewer x:Name="ProgramScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,20">
        <StackPanel>
          <Border x:Name="EmptyPanel" Background="White" BorderBrush="{StaticResource BorderBrush}"
                  BorderThickness="1" CornerRadius="12" Padding="24,40" Visibility="Collapsed">
            <StackPanel>
              <TextBlock x:Name="EmptyText" Text="표시할 프로그램이 없습니다." TextAlignment="Center"
                         Foreground="{StaticResource MutedBrush}" FontSize="13" LineHeight="22"/>
              <Button Content="전체 프로그램 보기" Click="ClearFilters_Click" Style="{StaticResource GhostButton}"
                      Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
            </StackPanel>
          </Border>
          <ItemsControl x:Name="AppCards" ItemTemplate="{StaticResource ListAppTemplate}" ItemsPanel="{StaticResource ListAppPanel}"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <ScrollViewer x:Name="SettingsView" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,26" MaxWidth="760">
        <TextBlock Text="설정" FontSize="23" FontWeight="Bold" Margin="0,0,0,22"/>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="시작 및 종료" FontSize="15" FontWeight="Bold" Margin="0,0,0,20"/>
            <CheckBox x:Name="AutoStartCheck" Content="Windows 시작 시 자동 실행" IsEnabled="False"
                      Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
            <TextBlock Text="로그인하면 창을 띄우지 않고 트레이에서 시작합니다." TextWrapping="Wrap"
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
            <TextBlock Text="창을 닫아도 트레이에서 실행됩니다. 완전히 끝내려면 트레이 메뉴의 ‘종료’를 선택하세요."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
          <StackPanel>
            <TextBlock Text="업데이트 확인" FontSize="15" FontWeight="Bold" Margin="0,0,0,20"/>
            <CheckBox x:Name="StartupCheck" Content="런처를 시작할 때 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,0,0,18"/>
            <CheckBox x:Name="PeriodicCheck" Content="실행 중 주기적으로 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
            <Grid Margin="0,18,0,0" IsEnabled="{Binding IsChecked, ElementName=PeriodicCheck}">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="확인 간격" FontSize="12" FontWeight="SemiBold"/>
                <TextBlock Text="기본 1시간 · 런처 실행 중에만 확인합니다." Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,12,0"/>
              </StackPanel>
              <ComboBox x:Name="CheckIntervalInput" Grid.Column="1" SelectedValuePath="Key"
                        SelectionChanged="Setting_Changed" AutomationProperties.Name="업데이트 확인 간격">
                <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}"/></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <CheckBox x:Name="UpdateNotificationCheck" Content="업데이트 알림" IsEnabled="False"
                      Checked="Setting_Changed" Unchecked="Setting_Changed" Margin="0,22,0,0"/>
            <TextBlock Text="새 버전을 찾으면 트레이로 알려줍니다. 꺼도 업데이트 확인은 계속됩니다."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="GitHub 연결" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
            <TextBlock x:Name="GitHubStatusText" Text="연결 상태 확인 중…" FontSize="12" Margin="0,0,0,8"/>
            <TextBlock Text="비공개 저장소의 앱을 설치하고 업데이트합니다. 토큰은 이 PC의 Windows 자격 증명 관리자에 보관합니다."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
            <TextBlock Text="개인 액세스 토큰" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <PasswordBox x:Name="GitHubTokenInput" MaxLength="1280" Padding="10,8" FontSize="13"
                         AutomationProperties.Name="GitHub 개인 액세스 토큰"/>
            <TextBlock Text="Fine-grained 토큰에서 사용할 저장소를 선택하고 Contents 권한을 Read-only로 지정하세요."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,12"/>
            <WrapPanel>
              <Button x:Name="ConnectGitHubButton" Content="연결" Click="ConnectGitHub_Click" IsEnabled="False"
                      Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
              <Button x:Name="DisconnectGitHubButton" Content="연결 해제" Click="DisconnectGitHub_Click" IsEnabled="False" Margin="0,0,8,0"/>
              <Button Content="토큰 발급 페이지" Click="OpenGitHubTokenSettings_Click" Style="{StaticResource GhostButton}"/>
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,16,0,0">
          <StackPanel>
            <TextBlock Text="프로그램과 데이터" FontSize="15" FontWeight="Bold" Margin="0,0,0,16"/>
            <TextBlock x:Name="DataPathText" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,14"/>
            <WrapPanel>
              <Button Content="데이터 폴더 열기" Click="OpenDataFolder_Click" FontSize="11" Margin="0,0,8,8"/>
              <Button Content="카탈로그 가져오기" Click="ImportCatalog_Click" FontSize="11" Margin="0,0,8,8"/>
              <Button Content="카탈로그 내보내기" Click="ExportCatalog_Click" FontSize="11" Margin="0,0,0,8"/>
            </WrapPanel>
            <TextBlock Text="비공개 앱은 이 PC의 개인 카탈로그에만 저장됩니다. 내보내기에는 공개 여부를 확인한 앱만 포함합니다."
                       TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
        <DockPanel Margin="0,14,0,0">
          <Button DockPanel.Dock="Right" Content="런처 종료" Click="Exit_Click"
                  Style="{StaticResource GhostButton}" FontSize="11" AutomationProperties.Name="런처 완전히 종료"/>
          <TextBlock x:Name="LauncherVersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
        </DockPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,0">
      <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StatusText" Text="모아에 오신 것을 환영합니다." Foreground="{StaticResource MutedBrush}"
                   FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,15,0"/>
        <TextBlock x:Name="LastCheckedText" Grid.Column="1" Text="아직 확인하지 않음" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
      </Grid>
    </Border>
  </Grid>
</Window>
