<Window x:Class="MoaLauncher.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Moa Launcher" Width="1260" Height="850" MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen" Background="#11141B" Style="{StaticResource {x:Type Window}}">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="208"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="#161A23" BorderBrush="#2A303C" BorderThickness="0,0,1,0">
      <DockPanel Margin="22,32,22,22">
        <StackPanel DockPanel.Dock="Top">
          <StackPanel Orientation="Horizontal" Margin="4,0,0,40">
            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentBrush}" Margin="0,0,11,0"><TextBlock Text="m" Foreground="#23321D" FontFamily="Segoe UI" FontWeight="Bold" FontSize="30" TextAlignment="Center" Margin="0,-5,0,0"/></Border>
            <StackPanel><TextBlock Text="moa" FontFamily="Segoe UI" FontWeight="Bold" FontSize="25" Margin="0,-5,0,0"/><TextBlock Text="L A U N C H E R" FontSize="9" Foreground="{StaticResource MutedBrush}"/></StackPanel>
          </StackPanel>
          <TextBlock Text="WORKSPACE" FontSize="10" Foreground="#738097" Margin="12,0,0,14"/>
          <Button x:Name="LibraryNav" Content="▦   내 프로그램" Click="Library_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8" Background="#2B3540" BorderThickness="0"/>
          <Button x:Name="UpdatesNav" Content="↓   업데이트" Click="Updates_Click" Background="Transparent" BorderThickness="0" Margin="0,0,0,8"/>
          <Button x:Name="SettingsNav" Content="⚙   설정" Click="Settings_Click" Background="Transparent" BorderThickness="0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom">
          <Border Background="#202631" CornerRadius="12" Padding="14" Margin="0,0,0,20"><StackPanel><TextBlock Text="함께 늘어나는 도구들" FontWeight="Bold" FontSize="12"/><TextBlock Text="새 프로그램도 모아에&#10;간편하게 추가하세요." Foreground="{StaticResource MutedBrush}" FontSize="11" LineHeight="20" Margin="0,7,0,12"/><Button Content="＋ 프로그램 추가" Click="AddApp_Click" Padding="8,8" FontSize="11"/></StackPanel></Border>
          <TextBlock Text="Moa Launcher  0.1.0" FontSize="11" Foreground="#7E8AA0" Margin="4,0,0,4"/>
          <TextBlock Text="Windows · GitHub Releases" FontSize="10" Foreground="#606C81" Margin="4,0,0,0"/>
        </StackPanel>
        <Grid/>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1">
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="LibraryView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="34,32,34,28">
          <DockPanel Margin="0,0,0,26">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button x:Name="RefreshButton" Content="↻  업데이트 확인" Click="Refresh_Click" Margin="0,0,10,0"/><Button Content="＋ 프로그램 추가" Style="{StaticResource PrimaryButton}" Click="AddApp_Click"/></StackPanel>
            <StackPanel><TextBlock Text="YOUR EVERYDAY TOOLKIT" FontSize="10" Foreground="#8C9AAB" Margin="0,0,0,8"/><TextBlock x:Name="PageTitle" Text="내 프로그램" FontSize="28" FontWeight="Bold"/></StackPanel>
          </DockPanel>
          <Border Background="#202B2A" BorderBrush="#35423A" BorderThickness="1" CornerRadius="16" Padding="26,24" Margin="0,0,0,28">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel><TextBlock Text="좋아하는 도구를, 한곳에 모아." FontSize="22" FontWeight="Bold" Foreground="#E5F1DC"/><TextBlock Text="설치부터 업데이트까지. 준비된 앱으로 바로 시작하세요." Foreground="#A8B8AF" FontSize="12" Margin="0,10,0,0"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                <StackPanel Width="60"><TextBlock x:Name="TotalCount" Text="1" TextAlignment="Center" FontSize="27" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text="전체 앱" FontSize="10" TextAlignment="Center" Foreground="#A8B8AF" Margin="0,5,0,0"/></StackPanel>
                <Border Width="1" Background="#455247" Margin="12,4"/>
                <StackPanel Width="60"><TextBlock x:Name="InstalledCount" Text="0" TextAlignment="Center" FontSize="27" FontFamily="Segoe UI" FontWeight="SemiBold"/><TextBlock Text="설치됨" FontSize="10" TextAlignment="Center" Foreground="#A8B8AF" Margin="0,5,0,0"/></StackPanel>
                <Border Width="1" Background="#455247" Margin="12,4"/>
                <StackPanel Width="60"><TextBlock x:Name="UpdateCount" Text="0" TextAlignment="Center" FontSize="27" FontFamily="Segoe UI" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/><TextBlock Text="업데이트" FontSize="10" TextAlignment="Center" Foreground="#A8B8AF" Margin="0,5,0,0"/></StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <DockPanel Margin="0,0,0,18">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Right" Width="240" TextChanged="Search_Changed" ToolTip="프로그램 이름, 설명, 저장소 검색" AutomationProperties.Name="프로그램 검색"/>
            <TextBlock Text="프로그램 검색  →" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#8290A5" FontSize="11" Margin="0,0,10,0"/>
            <StackPanel Orientation="Horizontal"><Button x:Name="AllFilter" Content="전체" Click="All_Click" Padding="16,8" Background="#354339" BorderBrush="#506347" Margin="0,0,8,0"/><Button x:Name="InstalledFilter" Content="설치된 앱" Click="Installed_Click" Padding="16,8" Background="Transparent"/></StackPanel>
          </DockPanel>
          <TextBlock x:Name="EmptyText" Text="표시할 프로그램이 없습니다." Foreground="#9CA7BA" Margin="0,25,0,25" Visibility="Collapsed"/>
          <ItemsControl x:Name="AppCards">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Width="294" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,16,16">
                <StackPanel>
                  <DockPanel Margin="0,0,0,18"><TextBlock DockPanel.Dock="Right" Text="{Binding Category}" Foreground="#94A0B5" FontSize="10" VerticalAlignment="Center"/><Border Width="50" Height="50" CornerRadius="15" Background="{Binding AccentColor}" HorizontalAlignment="Left"><TextBlock Text="{Binding Monogram}" FontFamily="Segoe UI" FontSize="23" FontWeight="Bold" Foreground="#192332" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></DockPanel>
                  <TextBlock Text="{Binding Name}" FontSize="20" FontWeight="Bold"/>
                  <TextBlock Text="{Binding Description}" Foreground="#A4AEC0" FontSize="12" LineHeight="21" Height="44" TextTrimming="CharacterEllipsis" Margin="0,9,0,16"/>
                  <TextBlock Text="{Binding VersionText}" Foreground="#A8B3C5" FontSize="11"/>
                  <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,7,0,12"/>
                  <ProgressBar Value="{Binding Percent}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,10"/>
                  <TextBlock Text="{Binding Error}" Foreground="#FFADAD" FontSize="11" Margin="0,0,0,10" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}"/>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="{Binding ActionText}" IsEnabled="{Binding CanAct}" Style="{StaticResource PrimaryButton}" Click="AppAction_Click" Padding="12,10"/><Button Grid.Column="1" Content="···" Click="Details_Click" ToolTip="앱 상세 정보" Margin="8,0,0,0" Padding="14,8"/></Grid>
                  <Button Content="다운로드 취소" Click="Cancel_Click" Visibility="{Binding CanCancel, Converter={StaticResource BoolVisibility}}" Margin="0,8,0,0" Padding="8,6"/>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border x:Name="DetailsPanel" Background="#191E28" BorderBrush="#2B3341" BorderThickness="1" CornerRadius="14" Padding="22" Margin="0,8,0,0" Visibility="Collapsed">
            <StackPanel>
              <DockPanel><Button DockPanel.Dock="Right" Content="닫기" Click="CloseDetails_Click" Padding="10,5"/><TextBlock Text="{Binding Name, StringFormat={}{0} · 릴리스 노트}" FontSize="16" FontWeight="Bold"/></DockPanel>
              <TextBlock Text="{Binding LatestText}" Foreground="{StaticResource AccentBrush}" Margin="0,12,0,4"/><TextBlock Text="{Binding SourceText}" Foreground="#8997AC" FontSize="11"/>
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,16,0,18"><TextBlock Text="{Binding Notes}" Foreground="#B8C2D2" LineHeight="22"/></ScrollViewer>
              <WrapPanel><Button Content="GitHub에서 보기 ↗" Click="OpenRepository_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="설치 폴더" Click="OpenInstallFolder_Click" IsEnabled="{Binding IsInstalled}" Padding="12,8" Margin="0,0,8,8"/><Button Content="프로그램 설정" Click="EditApp_Click" Padding="12,8" Margin="0,0,8,8"/><Button Content="앱 실행 ↗" Click="Launch_Click" IsEnabled="{Binding IsInstalled}" Padding="12,8" Margin="0,0,8,8"/></WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="#171C25" CornerRadius="12" Padding="20,16" Margin="0,18,0,0"><DockPanel><TextBlock Text="↙" FontSize="26" Foreground="#839475" Margin="0,0,16,0"/><StackPanel><TextBlock Text="내 도구는 계속 늘어나니까" FontWeight="Bold" FontSize="12"/><TextBlock Text="GitHub 저장소와 배포 파일 규칙을 등록하면 새 앱도 모아에서 관리할 수 있어요." FontSize="11" Foreground="#8D99AD" Margin="0,5,0,0"/></StackPanel></DockPanel></Border>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,36"><TextBlock Text="설정" FontSize="28" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock Text="모아를 사용하는 방식을 정하세요." Foreground="#9CA7BA" Margin="0,0,0,28"/>
          <Border Background="#1B202B" CornerRadius="14" Padding="24"><StackPanel><TextBlock Text="업데이트 확인" FontSize="17" FontWeight="Bold"/><CheckBox x:Name="StartupCheck" Content="모아 런처를 열 때 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed"/><CheckBox x:Name="PeriodicCheck" Content="실행 중 30분마다 새 버전 확인" Checked="Setting_Changed" Unchecked="Setting_Changed"/><TextBlock Text="설치와 업데이트는 프로그램의 버튼을 눌렀을 때 시작합니다." Foreground="#8F9CAF" FontSize="12" Margin="0,18,0,0"/></StackPanel></Border>
          <Border Background="#1B202B" CornerRadius="14" Padding="24" Margin="0,18,0,0"><StackPanel><TextBlock Text="앱 카탈로그와 저장 위치" FontSize="17" FontWeight="Bold"/><TextBlock x:Name="DataPathText" Foreground="#A8B3C5" Margin="0,15,0,15"/><WrapPanel><Button Content="데이터 폴더 열기" Click="OpenDataFolder_Click" Margin="0,0,10,10"/><Button Content="카탈로그 가져오기" Click="ImportCatalog_Click" Margin="0,0,10,10"/><Button Content="카탈로그 내보내기" Click="ExportCatalog_Click" Margin="0,0,0,10"/></WrapPanel><TextBlock Text="JSON 카탈로그를 가져오면 앱이 추가되거나 같은 ID의 설정이 변경됩니다. 신뢰하는 배포자의 파일을 사용하세요." Foreground="#8F9CAF" FontSize="12" Margin="0,8,0,0"/></StackPanel></Border>
          <TextBlock Text="Moa Launcher 0.1.0 · Windows용&#10;GitHub Releases의 공식 배포 파일을 내려받고 SHA-256을 확인합니다." Foreground="#75839A" FontSize="12" LineHeight="24" Margin="0,28,0,0"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="1" BorderBrush="#2A303C" BorderThickness="0,1,0,0" Padding="24,12" Background="#151923"><DockPanel><TextBlock x:Name="LastCheckedText" DockPanel.Dock="Right" Text="아직 확인하지 않음" Foreground="#75839A" FontSize="10"/><TextBlock x:Name="StatusText" Text="모아에 오신 것을 환영합니다." Foreground="#A5B2C5" FontSize="11" TextTrimming="CharacterEllipsis"/></DockPanel></Border>
    </Grid>
  </Grid>
</Window>
