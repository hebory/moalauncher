<Window x:Class="MoaLauncher.App.AppEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="프로그램 설정 · Moa Launcher"
        Width="620" Height="780" MinWidth="560" MinHeight="640"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Style="{StaticResource {x:Type Window}}">
  <Grid Background="{StaticResource BackgroundBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Grid Margin="30,25,30,19">
      <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Width="40" Height="40" CornerRadius="12" Background="{StaticResource SoftAccentBrush}">
        <TextBlock Text="＋" Foreground="{StaticResource AccentBrush}" FontSize="23"
                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
      </Border>
      <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
        <TextBlock x:Name="Heading" Text="새 프로그램 추가" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="GitHub Releases에 게시된 앱을 라이브러리에 연결합니다."
                   Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>
    </Grid>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="30,0,30,16">
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20,18">
          <StackPanel>
            <TextBlock Text="앱 정보" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,15"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="프로그램 이름" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
                <TextBox x:Name="NameInput" Margin="0,6,0,14" AutomationProperties.Name="프로그램 이름"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="프로그램 ID" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
                <TextBox x:Name="IdInput" Margin="0,6,0,14" ToolTip="영문 소문자, 숫자, 하이픈으로 구성합니다."
                         AutomationProperties.Name="프로그램 ID"/>
              </StackPanel>
            </Grid>
            <TextBlock Text="GitHub 저장소" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
            <TextBox x:Name="RepositoryInput" Margin="0,6,0,5" ToolTip="owner/repo 또는 https://github.com/owner/repo"
                     AutomationProperties.Name="GitHub 저장소"/>
            <TextBlock Text="공개 저장소 주소 또는 owner/repo 형식으로 입력하세요."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,14"/>
            <TextBlock Text="한 줄 소개" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
            <TextBox x:Name="DescriptionInput" Height="40" Margin="0,6,0,0"
                     AutomationProperties.Name="프로그램 설명"/>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,14,0,0">
          <StackPanel>
            <TextBlock Text="배포 파일" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="릴리스 자산의 이름과 앱 실행 파일을 지정합니다."
                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,15"/>
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="패키지 형식" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
                <ComboBox x:Name="KindInput" SelectedIndex="0" Margin="0,6,0,0" SelectionChanged="Kind_Changed">
                  <ComboBoxItem Content="포터블 ZIP" Tag="zip"/>
                  <ComboBoxItem Content="Inno Setup 설치 파일" Tag="inno"/>
                </ComboBox>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="지원 아키텍처" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
                <ComboBox x:Name="ArchitectureInput" SelectedIndex="0" Margin="0,6,0,0">
                  <ComboBoxItem Content="x64"/><ComboBoxItem Content="arm64"/><ComboBoxItem Content="x86"/>
                </ComboBox>
              </StackPanel>
            </Grid>

            <TextBlock Text="릴리스 파일 패턴" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
            <TextBox x:Name="PatternInput" Margin="0,6,0,5" ToolTip="* 와 ?를 포함할 수 있습니다."
                     AutomationProperties.Name="릴리스 파일 패턴"/>
            <TextBlock Text="예: MyApp-*-win-x64.zip · 패턴에 맞는 파일 하나만 선택됩니다."
                       Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,0,0,14"/>

            <TextBlock Text="실행 파일 경로" FontSize="11" FontWeight="SemiBold" Foreground="#525D70"/>
            <TextBox x:Name="ExecutableInput" Margin="0,6,0,0"
                     ToolTip="ZIP 압축 또는 설치 폴더 기준 상대 경로입니다."
                     AutomationProperties.Name="실행 파일"/>

            <StackPanel x:Name="InstallDirectoryPanel" Visibility="Collapsed" Margin="0,14,0,0">
              <TextBlock Text="설치 폴더 · %LOCALAPPDATA% 기준" FontSize="11"
                         FontWeight="SemiBold" Foreground="#525D70"/>
              <TextBox x:Name="DirectoryInput" Margin="0,6,0,0" ToolTip="예: Programs/MyApp"
                       AutomationProperties.Name="설치 폴더"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Background="{StaticResource SoftAccentBrush}" CornerRadius="9" Padding="13,10" Margin="0,14,0,0">
          <DockPanel>
            <TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="14"
                       FontWeight="Bold" Margin="0,0,9,0" VerticalAlignment="Center"/>
            <TextBlock Text="GitHub SHA-256 digest 또는 .sha256 / SHA256SUMS.txt 체크섬이 있는 릴리스만 설치할 수 있습니다."
                       Foreground="#4D5AA7" FontSize="10" LineHeight="16"/>
          </DockPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Row="2" Background="{StaticResource PanelBrush}">
      <Border Height="1" Background="{StaticResource BorderBrush}" VerticalAlignment="Top"/>
      <Grid Margin="30,15,30,15">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="ErrorText" Foreground="#C43F53" FontSize="11" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"/>
        <StackPanel Grid.Column="1" Orientation="Horizontal">
          <Button Content="취소" Style="{StaticResource GhostButton}" IsCancel="True" Margin="0,0,9,0"
                  MinWidth="74"/>
          <Button Content="저장하고 연결" Style="{StaticResource PrimaryButton}" IsDefault="True"
                  Click="Save_Click" MinWidth="122"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
